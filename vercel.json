{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm ci",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/emergency",
      "destination": "/index.html"
    },
    {
      "source": "/services/business-permit",
      "destination": "/index.html"
    },
    {
      "source": "/services/civil-registry",
      "destination": "/index.html"
    },
    {
      "source": "/services/working-permit",
      "destination": "/index.html"
    },
    {
      "source": "/charter",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/directories",
      "destination": "/index.html"
    },
    {
      "source": "/transparency",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    }
  ]
}
