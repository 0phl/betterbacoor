{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterbacoor.org/schemas/resource.schema.json",
  "title": "BetterBacoor civic resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "category",
    "tags",
    "official_url",
    "source_title",
    "source_url",
    "source_page",
    "last_verified",
    "reviewer",
    "risk_level",
    "review_interval_days",
    "correction_url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "category": {
      "enum": ["service", "directory", "transparency", "official-system"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 140
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_page": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "risk_level": {
      "enum": ["ordinary", "high"]
    },
    "review_interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "correction_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
